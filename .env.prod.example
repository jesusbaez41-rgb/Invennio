# .env de PRODUCCIÓN — copiar a .env.prod y rellenar.
# Generar secretos con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Dominio público (SIN barra final). Ej: https://repositorio.unae.edu.py
INVENIO_SITE_UI_URL=https://TU-DOMINIO
INVENIO_SITE_API_URL=https://TU-DOMINIO/api
# Hosts permitidos (formato lista python). Incluye el dominio + localhost para salud interna.
INVENIO_TRUSTED_HOSTS=['TU-DOMINIO', 'localhost', '127.0.0.1']

# Base de datos (PONER CLAVE FUERTE — solo primera creación del volumen).
POSTGRES_HOST=db
POSTGRES_DB=inveniordm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA-ESTO-POR-UNA-CLAVE-LARGA

# Admin inicial (se crea con `invenio users create`).
INVENIO_ADMIN_EMAIL=admin@TU-DOMINIO
INVENIO_ADMIN_PASSWORD=CAMBIA-ESTO-TAMBIEN

# Secretos Flask (uno distinto para cada uno, generados con el comando de arriba).
INVENIO_SECRET_KEY=GENERA-UNO-NUEVO-AQUI
INVENIO_SECURITY_PASSWORD_SALT=GENERA-OTRO-NUEVO-AQUI

# Registro público cerrado: solo el admin crea usuarios.
INVENIO_SECURITY_REGISTERABLE=False

# Marca (ya viene con la de UNAE; cámbiala si el dominio es otro proyecto).
INVENIO_THEME_SITENAME=Repositorio UNAE Análisis
INVENIO_THEME_FRONTPAGE_TITLE=Repositorio UNAE Análisis
INVENIO_THEME_FRONTPAGE_SUBTITLE=Plataforma institucional para preservar, compartir y descubrir la producción académica.
INVENIO_THEME_LOGO=images/logo-unae.svg

# Mail real (si no, deja SUPPRESS en True y nadie recibe correos).
INVENIO_MAIL_SUPPRESS_SEND=True
INVENIO_MAIL_SERVER=127.0.0.1
INVENIO_MAIL_PORT=587
INVENIO_MAIL_USE_TLS=True
INVENIO_MAIL_USE_SSL=False
INVENIO_MAIL_USERNAME=
INVENIO_MAIL_PASSWORD=

# Memoria OpenSearch (ajusta a tu servidor; mínimo 512m).
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
